# name: test/sql/secret_connection_scope.test
# description: CREATE SECRET ... IN <attach_alias> ships secrets to the server's connection-scoped storage
# group: [sql]

require quack

require httpfs

statement ok con1
call quack_serve('quack:localhost:20188', token='s3kr3t');

sleep 200 millisecond

statement ok con2
create secret quack_auth (type quack, token 's3kr3t', scope 'quack:localhost:20188')

# two independent connections to the same server -> two server-side ClientContexts
statement ok con2
attach 'quack:localhost:20188' as q1 (type quack)

statement ok con2
attach 'quack:localhost:20188' as q2 (type quack)

# --- ship an s3 secret through q1 (lands in the server's quack_connection_storage, scoped to q1's connection) ---
statement ok con2
create secret s1 in q1 (type s3, key_id 'AKIA_Q1', secret 'a', region 'us-east-1', scope 's3://bucket-1')

# it executed on the server and is visible in q1's connection context
query I con2
from q1.query('select count(*) from duckdb_secrets() where name = ''s1'' and type = ''s3''')
----
1

# ISOLATION: the very same server, different connection (q2), does NOT see q1's secret
query I con2
from q2.query('select count(*) from duckdb_secrets() where name = ''s1''')
----
0

# scope round-tripped through the reconstructed CREATE SECRET SQL
query I con2
from q1.query('select scope = [''s3://bucket-1''] from duckdb_secrets() where name = ''s1''')
----
true

# --- CREATE OR REPLACE maps to OR REPLACE server-side ---
statement ok con2
create or replace secret s1 in q1 (type s3, key_id 'AKIA_Q1b', secret 'b', scope 's3://bucket-1')

query I con2
from q1.query('select count(*) from duckdb_secrets() where name = ''s1''')
----
1

# --- DROP SECRET ... FROM q1 removes it on the server ---
statement ok con2
drop secret s1 from q1

query I con2
from q1.query('select count(*) from duckdb_secrets() where name = ''s1''')
----
0

# --- fail-soft after DETACH: storage stays registered (no unregister API) but declines ---
statement ok con2
create secret s2 in q1 (type s3, key_id 'AKIA_Q1c', secret 'c', scope 's3://bucket-2')

statement ok con2
detach q1

statement error con2
create secret s3 in q1 (type s3, key_id 'x', secret 'y', scope 's3://b')
----
is not connected

# --- re-ATTACH rebinds the alias storage; the fresh connection has none of the prior secrets ---
statement ok con2
attach 'quack:localhost:20188' as q1 (type quack)

query I con2
from q1.query('select count(*) from duckdb_secrets() where name = ''s2''')
----
0

# rebind works: can ship again
statement ok con2
create secret s4 in q1 (type s3, key_id 'AKIA_Q1d', secret 'd', scope 's3://bucket-4')

query I con2
from q1.query('select count(*) from duckdb_secrets() where name = ''s4''')
----
1

statement ok con1
call quack_stop('quack:localhost:20188')
