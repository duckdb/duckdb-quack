# name: test/sql/set_within_text.test
# description: a SET in a multi-statement text applies to the statements that follow it in the same text
# group: [sql]

include test/template/quack_setup.test_template

# a one-row inline drain and a large target: without the SET below, this shape yields almost no FETCHes
statement ok quack_db:quack_server_con
SET GLOBAL quack_prepare_inline_rows = 1;

statement ok quack_db:quack_server_con
SET GLOBAL quack_target_batch_bytes = 1048576;

statement ok
CALL enable_logging('Quack');

# the SET must reach the SELECT in the same text: a 64 KiB target over ~1.6 MB of hashed rows
# forces many FETCH round trips, which the stale 1 MiB snapshot cannot produce
query II
select count(*), sum(i) from quack_query({server}, 'SET GLOBAL quack_target_batch_bytes=65536; SELECT i, hash(i) AS pad FROM range(100000) t(i)', token='asdf')
----
100000	4999950000

query I
select count(*) >= 10 from duckdb_logs_parsed('Quack') where message_type = 'FETCH_REQUEST'
----
true

statement ok
CALL disable_logging();

statement ok quack_db:quack_server_con
RESET GLOBAL quack_target_batch_bytes;

statement ok quack_db:quack_server_con
RESET GLOBAL quack_prepare_inline_rows;

include test/template/quack_teardown.test_template
