# name: test/sql/system_names_no_reload.test
# description: a name the system catalog holds does not reload the attached catalog
# group: [sql]

include test/template/quack_setup.test_template

statement ok
attach {server} as rpc (token 'asdf')

statement ok
create table rpc.t as select range::INT i from range(3)

statement ok
USE rpc

query I
select sum(i) from t
----
3

statement ok quack_db:quack_server_con
CALL enable_logging('Quack');

statement ok quack_db:quack_server_con
CALL truncate_duckdb_logs();

# the binder looks for each of these in rpc before it finds it in the system catalog
query I
select count(*) from pg_catalog.pg_attribute where attnum < 0
----
0

query I
select count(*) from pg_attribute where attnum < 0
----
0

query I
select count(*) from information_schema.columns where 1 = 0
----
0

query I
select count(*) from pg_catalog.pg_class where 1 = 0
----
0

query I quack_db:quack_server_con
select count(*) from duckdb_logs_parsed('Quack') where message_type = 'PREPARE_REQUEST' and query like '%duckdb_schemas()%'
----
0

# a name nobody holds still reloads, so a table made on the server after the attach is found
statement ok
call system.main.quack_query_by_name('rpc', 'CREATE TABLE late AS SELECT 7 AS v;')

query I
select v from late
----
7
