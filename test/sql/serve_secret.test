# name: test/sql/serve_secret.test
# description: quack_serve() takes its token from the default quack secret, secret='name' selects one by name
# group: [sql]

require quack

require httpfs

statement ok
SET quack_default_client_id='';

# --- 1. No secret: the token is auto-generated ---

statement ok
set variable srv = (select {'uri': listen_uri, 'url': listen_url, 'token': auth_token} from quack_serve('quack:localhost:0'));

query I
select length(getvariable('srv').token) = 32;
----
true

statement ok
call quack_stop(getvariable('srv').uri);

# --- 2. Default secret (catch-all `quack:` scope): quack_serve picks up its token ---

statement ok
create secret (type quack, token 'defaulttoken');

statement ok
set variable srv = (select {'uri': listen_uri, 'url': listen_url, 'token': auth_token} from quack_serve('quack:localhost:0'));

query I
select getvariable('srv').token;
----
defaulttoken

# the same secret authenticates the client, so an attach round-trips without an explicit token
statement ok
attach getvariable('srv').uri as r (type quack);

query II
from r.query('select 1, 2');
----
1	2

statement ok
detach r;

statement ok
call quack_stop(getvariable('srv').uri);

# an explicit token still wins over the default secret

statement ok
set variable srv = (select {'uri': listen_uri, 'url': listen_url, 'token': auth_token} from quack_serve('quack:localhost:0', token='explicit'));

query I
select getvariable('srv').token;
----
explicit

statement ok
call quack_stop(getvariable('srv').uri);

# --- 3. Named secret: `secret='s1'` selects it by name ---

statement ok
create secret s1 (type quack, token 'token_s1', scope 'quack:127.0.0.1:0');

statement ok
create secret s2 (type quack, token 'token_s2', scope 'quack:localhost:0');

# the name decides which secret is used, and its scope decides where we listen
statement ok
set variable srv = (select {'uri': listen_uri, 'url': listen_url, 'token': auth_token} from quack_serve(secret='s1'));

query II
select getvariable('srv').token, getvariable('srv').url like 'http://127.0.0.1:%';
----
token_s1	true

statement ok
call quack_stop(getvariable('srv').uri);

# an explicit URI overrules the scope of the named secret
statement ok
set variable srv = (select {'uri': listen_uri, 'url': listen_url, 'token': auth_token} from quack_serve('quack:localhost:0', secret='s1'));

query II
select getvariable('srv').token, getvariable('srv').url like 'http://localhost:%';
----
token_s1	true

statement ok
call quack_stop(getvariable('srv').uri);

# --- 4. Error cases ---

statement error
from quack_serve(secret='does_not_exist');
----
Secret with name "does_not_exist" not found

statement error
from quack_serve(secret=NULL);
----
secret cannot be NULL

statement error
from quack_serve('quack:localhost:0', secret='s1', token='abcd');
----
Cannot specify both token and secret

statement ok
create secret notatoken (type quack, scope 'quack:localhost:0');

statement error
from quack_serve(secret='notatoken');
----
Quack secret "notatoken" does not contain a token

statement ok
create secret two_scopes (type quack, token 'tok', scope ['quack:localhost:1111', 'quack:localhost:2222']);

statement error
from quack_serve(secret='two_scopes');
----
is scoped to multiple endpoints

query I
select count(*) from quack_server_list();
----
0
