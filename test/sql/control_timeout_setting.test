# name: test/sql/control_timeout_setting.test
# description: control request timeouts can be configured independently of data requests
# group: [sql]

require quack

query I
SELECT current_setting('quack_control_timeout');
----
2

statement ok
SET quack_control_timeout=5;

query II
SELECT current_setting('quack_control_timeout'), current_setting('quack_http_timeout');
----
5	86400

statement ok
RESET quack_control_timeout;

query I
SELECT current_setting('quack_control_timeout');
----
2
