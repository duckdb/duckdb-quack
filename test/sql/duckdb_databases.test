# name: test/sql/duckdb_databases.test
# description: A quack-attached database must show up cleanly in duckdb_databases()
# group: [sql]

include test/template/quack_setup.test_template

statement ok con2
attach {server} as my_remote (token 'asdf');

query III
select database_name, path = {server}, type from duckdb_databases() where database_name='my_remote';
----
my_remote	true	quack

statement ok con2
detach my_remote;

include test/template/quack_teardown.test_template
