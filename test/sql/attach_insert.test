# name: test/sql/attach_insert.test
# description: INSERT and CREATE TABLE AS over an rpc attach - batched append flush thresholds, edges, small-insert no-regression
# group: [sql]

include test/template/quack_setup.test_template

statement ok
attach {server} as rpc (token 'asdf')

# INSERT above the client flush threshold (STANDARD_VECTOR_SIZE * 100 = 204800): at least one
# mid-statement flush AND the Finalize flush both fire.
statement ok
create table rpc.big(i bigint);

statement ok
insert into rpc.big select * from range(500000)

query IIII
select count(*), min(i), max(i), sum(i) from rpc.big
----
500000	0	499999	124999750000

# Single-row insert must not regress: buffers one row, flushes once at Finalize.
statement ok
create table rpc.small(a int, b int);

statement ok
insert into rpc.small values (1, 2)

query II
select a, b from rpc.small
----
1	2

# Empty input: no rows, no append request body.
statement ok
create table rpc.emptytbl(i int);

statement ok
insert into rpc.emptytbl select * from range(0)

query I
select count(*) from rpc.emptytbl
----
0

# Small CTAS: single Finalize flush.
statement ok
create table rpc.ctas_small as select range a from range(10);

query I
select count(a) from rpc.ctas_small
----
10

# CTAS above the flush threshold: mid-statement flush + Finalize flush.
statement ok
create table rpc.ctas_big as select * from range(300000) t(i)

query II
select count(*), sum(i) from rpc.ctas_big
----
300000	44999850000

# A server-side append rejection (CHECK constraint) on a >threshold insert must surface as a
# failed statement: the error travels back through the async upload queue, not just at Finalize,
# and the defensive drain on the errored statement must not wedge the connection.
statement ok
create table rpc.checked(i bigint check (i < 250000));

statement error
insert into rpc.checked select * from range(500000)
----
CHECK constraint failed

# The connection survives the async error and stays usable for the next statement.
statement ok
create table rpc.recovered(i bigint);

statement ok
insert into rpc.recovered select * from range(1000)

query I
select count(*) from rpc.recovered
----
1000

# async_threads knob: =0 is the synchronous fallback, =1 serialized. Both must produce the same
# result as the default concurrent path.
statement ok
set async_threads=0;

statement ok
create table rpc.sync_load(i bigint);

statement ok
insert into rpc.sync_load select * from range(500000)

statement ok
set async_threads=1;

statement ok
insert into rpc.sync_load select * from range(500000)

query III
select count(*), min(i), max(i) from rpc.sync_load
----
1000000	0	499999

statement ok
reset async_threads;

# Parallel sink: several worker threads flush into the one shared upload queue (Combine path);
# the row count/sum must stay deterministic.
statement ok
set threads=4;

statement ok
create table rpc.parallel_load(i bigint);

statement ok
insert into rpc.parallel_load select * from range(500000)

query II
select count(*), sum(i) from rpc.parallel_load
----
500000	124999750000

statement ok
reset threads;

statement ok
drop table rpc.checked;

statement ok
drop table rpc.recovered;

statement ok
drop table rpc.sync_load;

statement ok
drop table rpc.parallel_load;

statement ok
drop table rpc.big;

statement ok
drop table rpc.small;

statement ok
drop table rpc.emptytbl;

statement ok
drop table rpc.ctas_small;

statement ok
drop table rpc.ctas_big;

statement ok con2
detach rpc;

include test/template/quack_teardown.test_template
