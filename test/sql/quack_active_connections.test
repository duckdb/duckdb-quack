# name: test/sql/quack_active_connections.test
# description: test quacktivity function for the quack extension
# group: [sql]

include test/template/quack_setup.test_template

statement ok quack_db:quack_server_con
create table fuu as values(42, 43);

# no connections yet
query I
select count(*) from quack_active_connections();
----
0

# attach creates a persistent QuackClientConnection
statement ok
attach {server} as rpc2 (token 'asdf');

query I quack_db:quack_server_con
select state from quack_active_connections();
----
finished

loop i 0 3

query II
from quack_query_by_name('rpc2', 'SELECT * FROM fuu');
----
42	43

query I quack_db:quack_server_con
select count(*) from quack_active_connections();
----
1

query I quack_db:quack_server_con
select starts_with(query, 'SELECT') from quack_active_connections();
----
true

# client id hash is NULL, because there is no client id input
query I quack_db:quack_server_con
select client_id_hash from quack_active_connections();
----
NULL

endloop

# two clients on the same server
statement ok
attach {server} as rpc3 (token 'asdf', client_id 'random_client_id');

query I quack_db:quack_server_con
select count(*) from quack_active_connections();
----
2

query I quack_db:quack_server_con
SELECT count(*) FILTER (WHERE client_id_hash IS NOT NULL) from quack_active_connections();
----
1

# check the actual md5 formula: hash(token + client_id), NOT including session_id/connection_id
query I quack_db:quack_server_con
SELECT client_id_hash = md5('asdf' || 'random_client_id')
  from quack_active_connections() WHERE client_id_hash IS NOT NULL;
----
true

# --- reconnect-key contract  ---
statement ok
attach {server} as rpc4 (token 'asdf', client_id 'random_client_id');

# rpc3 and rpc4 share client_id 'random_client_id' + token 'asdf', so their hashes MUST be equal
query I quack_db:quack_server_con
SELECT count(DISTINCT client_id_hash) FROM quack_active_connections() WHERE client_id_hash IS NOT NULL;
----
1

statement ok
detach rpc4;

statement ok
detach rpc3;

query I quack_db:quack_server_con
select count(*) from quack_active_connections();
----
1

# detach removes the session
statement ok
detach rpc2;

query I quack_db:quack_server_con
select count(*) from quack_active_connections();
----
0

include test/template/quack_teardown.test_template
