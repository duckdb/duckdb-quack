# name: test/sql/clear_cache.test
# description: a table or schema created on the server after attach is found without a refresh; quack_clear_cache still refreshes the cached snapshot
# group: [sql]

include test/template/quack_setup.test_template

statement ok
PRAGMA disable_optimizer

statement ok
create secret (type quack, token 'asdf')

statement ok
attach {server} as rpc

statement ok
call system.main.quack_query_by_name('rpc', 'CREATE TABLE t1(i INTEGER); INSERT INTO t1 VALUES (1),(2),(3);')

# not in the cached catalog: the lookup reloads it once and finds the table
query I
SELECT i FROM rpc.t1 ORDER BY i
----
1
2
3

statement ok
call system.main.quack_query_by_name('rpc', 'CREATE TABLE t2(s VARCHAR); INSERT INTO t2 VALUES (''a''),(''b'');')

query I
SELECT s FROM rpc.t2 ORDER BY s
----
a
b

statement ok
call system.main.quack_query_by_name('rpc', 'DROP TABLE t1;')

query I
SELECT s FROM rpc.t2 ORDER BY s
----
a
b

# the table is gone on the server, but our catalog cache still has it: the error comes back from the
# server, carrying the type it was raised with there
statement error
SELECT i FROM rpc.t1
----
Catalog Error: Table with name t1 does not exist

statement ok
CALL quack_clear_cache()

statement error
SELECT i FROM rpc.t1
----
Catalog Error: Table with name t1 does not exist

# a schema made on the server after attach, and a table in it
statement ok
call system.main.quack_query_by_name('rpc', 'CREATE SCHEMA late; CREATE TABLE late.t3(i INTEGER); INSERT INTO late.t3 VALUES (7);')

query I
SELECT i FROM rpc.late.t3
----
7

# a name the server does not have either is still not found
statement error
SELECT i FROM rpc.nowhere
----
Table with name nowhere does not exist

statement error
SELECT i FROM rpc.nowhere_schema.t
----
nowhere_schema

statement ok
detach rpc;

include test/template/quack_teardown.test_template
