# name: test/sql/attach_secret_name.test
# description: ATTACH honors a SECRET name, and a bare 'quack:' takes its endpoint from that secret
# group: [sql]

require quack

require httpfs

statement ok
SET quack_default_client_id='';

# --- 1. A named secret supplies the token, and its scope supplies the endpoint for a bare 'quack:' ---

statement ok
create secret s1 (type quack, token 'token_s1', scope 'quack:127.0.0.1:9495');

# a second secret that must not be picked up: the name is what decides
statement ok
create secret s2 (type quack, token 'token_s2', scope 'quack:127.0.0.1:9496');

statement ok
from quack_serve(secret='s1');

statement ok
attach 'quack:' as r (type quack, secret s1);

query II
from r.query('select 1, 2');
----
1	2

# the endpoint came from the secret scope, not from the attach path
query I
select path from duckdb_databases() where database_name='r';
----
quack:127.0.0.1:9495

statement ok
detach r;

# a quoted name works the same
statement ok
attach 'quack:' as r (type quack, secret 's1');

query II
from r.query('select 1, 2');
----
1	2

statement ok
detach r;

# an explicit path overrules the scope of the named secret
statement ok
attach 'quack:127.0.0.1:9495' as r (type quack, secret s1);

query II
from r.query('select 1, 2');
----
1	2

statement ok
detach r;

# the named secret decides the token, so the wrong name fails authentication
statement error
attach 'quack:127.0.0.1:9495' as r_bad (type quack, secret s2);
----
Authentication failed

statement ok
call quack_stop('quack:127.0.0.1:9495');

statement ok
drop secret s1

statement ok
drop secret s2

# --- 2. Without a name, a bare 'quack:' uses the default secret ---

# the catch-all `quack:` scope names no endpoint, so we fall back to the default host
statement ok
create secret (type quack, token 'defaulttoken');

statement ok
from quack_serve();

statement ok
attach 'quack:' as r (type quack);

query I
select path from duckdb_databases() where database_name='r';
----
quack:localhost

query II
from r.query('select 1, 2');
----
1	2

statement ok
detach r;

statement ok
call quack_stop('quack:localhost');

statement ok
drop secret __default_quack

# a lone scoped secret is the default one: it supplies both endpoint and token
statement ok
create secret only_one (type quack, token 'token_only', scope 'quack:127.0.0.1:9497');

statement ok
from quack_serve();

statement ok
attach 'quack:' as r (type quack);

query I
select path from duckdb_databases() where database_name='r';
----
quack:127.0.0.1:9497

query II
from r.query('select 1, 2');
----
1	2

statement ok
detach r;

statement ok
call quack_stop('quack:127.0.0.1:9497');

# with more than one candidate and no name, nothing is guessed
statement ok
create secret other_one (type quack, token 'token_other', scope 'quack:127.0.0.1:9498');

statement error
attach 'quack:' as r (type quack);
----
Could not find a Quack authentication token

# --- 3. Error cases ---

statement error
attach 'quack:' as r (type quack, secret does_not_exist);
----
Secret with name "does_not_exist" not found

statement error
attach 'quack:' as r (type quack, secret only_one, token 'abcd');
----
Cannot specify both token and secret

statement ok
create secret notatoken (type quack, scope 'quack:127.0.0.1:9499');

statement error
attach 'quack:' as r (type quack, secret notatoken);
----
Quack secret "notatoken" does not contain a token

statement ok
create secret s3 (type s3, key_id 'a', secret 'b');

statement error
attach 'quack:' as r (type quack, secret s3);
----
a secret of type "quack" is required

query I
select count(*) from quack_server_list();
----
0
