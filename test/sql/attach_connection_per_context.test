# name: test/sql/attach_connection_per_context.test
# description: connections of one database instance get their own server connection, so their transactions stay apart (#332)
# group: [sql]

include test/template/quack_setup.test_template

statement ok
attach {server} as rpc (token 'asdf')

statement ok
create table rpc.t(i INT)

statement ok con1
BEGIN

statement ok con1
insert into rpc.t values (1)

statement ok con2
BEGIN

statement ok con2
insert into rpc.t values (2)

query I con1
from rpc.t
----
1

query I con2
from rpc.t
----
2

statement ok con1
ROLLBACK

statement ok con2
COMMIT

query I
from rpc.t
----
2
